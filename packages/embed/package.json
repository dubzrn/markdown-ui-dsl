{
  "name": "@mdui/embed",
  "version": "0.0.0",
  "description": "Embed Markdown UI DSL wireframes in documents: self-contained SVG renderer and markdown-it / remark / rehype adapters.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@mdui/core": "workspace:*",
    "@mdui/render": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "markdown-it": "^15.0.2",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  }
}
