{
  "name": "@mdui/tokens",
  "version": "0.0.0",
  "description": "Design-system loader (DESIGN.md + legacy prose), token references, exporters and contrast checks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "yaml": "2.9.1"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  }
}
