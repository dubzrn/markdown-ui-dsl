{
  "name": "@mdui/mcp",
  "version": "0.0.0",
  "description": "MCP server for Markdown UI DSL: parse, validate, lint, fix, format, diff, render, prompt, grammar and coverage as tools.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "mdui-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@mdui/catalog": "workspace:*",
    "@mdui/core": "workspace:*",
    "@mdui/grammar": "workspace:*",
    "@mdui/lint": "workspace:*",
    "@mdui/render": "workspace:*",
    "@mdui/spec": "workspace:*",
    "@mdui/tokens": "workspace:*",
    "@mdui/tools": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  }
}
