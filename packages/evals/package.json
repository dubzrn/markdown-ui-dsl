{
  "name": "@vrillabs/mdui-evals",
  "version": "0.1.0",
  "description": "LLM evaluation harness for Markdown UI DSL: tool-agnostic deterministic scoring, provider adapters, constrained-decoding arms.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@vrillabs/mdui-catalog": "workspace:*",
    "@vrillabs/mdui-core": "workspace:*",
    "@vrillabs/mdui-grammar": "workspace:*",
    "@vrillabs/mdui-lint": "workspace:*",
    "@vrillabs/mdui-tools": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dubzrn/markdown-ui-dsl.git",
    "directory": "packages/evals"
  },
  "homepage": "https://github.com/dubzrn/markdown-ui-dsl#readme",
  "bugs": {
    "url": "https://github.com/dubzrn/markdown-ui-dsl/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "private": true
}
