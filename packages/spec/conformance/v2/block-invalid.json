[
  {
    "id": "typed-closer-mismatch",
    "input": "---\ndsl: 2.0\n---\n::: CARD :::\nx\n--- END COLUMN ---\n",
    "expect": {
      "outline": "frontmatter,card(line)",
      "diagnostics": [
        {
          "code": "E1004",
          "line": 6
        }
      ]
    },
    "since": "2.0"
  },
  {
    "id": "typed-closer-mismatch-inner",
    "input": "---\ndsl: 2.0\n---\n||| COLUMN |||\n::: CARD :::\n--- END COLUMN ---\n--- END CARD ---\n",
    "expect": {
      "outline": "frontmatter,column(card())",
      "diagnostics": [
        {
          "code": "E1004",
          "line": 6
        },
        {
          "code": "E1004",
          "line": 7
        }
      ]
    },
    "since": "2.0",
    "notes": "each closer closes the innermost block and is checked against it"
  },
