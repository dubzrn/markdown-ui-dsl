{
  "name": "@vrillabs/mdui-spec",
  "version": "0.1.0",
  "description": "Normative Markdown UI DSL specification artifacts (grammar, version constants, diagnostic catalogue).",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./grammar/*": "./grammar/*",
    "./schema/*": "./schema/*",
    "./conformance/*": "./conformance/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "grammar",
    "schema",
    "conformance",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dubzrn/markdown-ui-dsl.git",
    "directory": "packages/spec"
  },
  "homepage": "https://github.com/dubzrn/markdown-ui-dsl#readme",
  "bugs": {
    "url": "https://github.com/dubzrn/markdown-ui-dsl/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19"
  }
}
