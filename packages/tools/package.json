{
  "name": "@mdui/tools",
  "version": "0.0.0",
  "description": "Semantic diff and migration tools for Markdown UI DSL documents.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@mdui/core": "workspace:*",
    "@mdui/lint": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  }
}
