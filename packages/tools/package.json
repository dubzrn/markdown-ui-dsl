{
  "name": "@vrillabs/mdui-tools",
  "version": "0.1.0",
  "description": "Semantic diff and migration tools for Markdown UI DSL documents.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@vrillabs/mdui-catalog": "workspace:*",
    "@vrillabs/mdui-core": "workspace:*",
    "@vrillabs/mdui-lint": "workspace:*",
    "@vrillabs/mdui-tokens": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dubzrn/markdown-ui-dsl.git",
    "directory": "packages/tools"
  },
  "homepage": "https://github.com/dubzrn/markdown-ui-dsl#readme",
  "bugs": {
    "url": "https://github.com/dubzrn/markdown-ui-dsl/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19"
  }
}
