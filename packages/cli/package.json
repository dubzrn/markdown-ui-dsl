{
  "name": "@vrillabs/mdui-cli",
  "version": "0.1.0",
  "description": "mdui command line: validate, lint, ast (and more) for Markdown UI DSL files.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "mdui": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@vrillabs/mdui-catalog": "workspace:*",
    "@vrillabs/mdui-core": "workspace:*",
    "@vrillabs/mdui-grammar": "workspace:*",
    "@vrillabs/mdui-lint": "workspace:*",
    "@vrillabs/mdui-oracle": "workspace:*",
    "@vrillabs/mdui-render": "workspace:*",
    "@vrillabs/mdui-spec": "workspace:*",
    "@vrillabs/mdui-sync": "workspace:*",
    "@vrillabs/mdui-tokens": "workspace:*",
    "@vrillabs/mdui-tools": "workspace:*",
    "@vrillabs/mdui-export": "workspace:*",
    "@vrillabs/mdui-embed": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "peerDependencies": {
    "playwright-core": ">=1.49"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dubzrn/markdown-ui-dsl.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/dubzrn/markdown-ui-dsl#readme",
  "bugs": {
    "url": "https://github.com/dubzrn/markdown-ui-dsl/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19"
  }
}
