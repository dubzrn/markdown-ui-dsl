{
  "name": "@mdui/export",
  "version": "0.0.0",
  "description": "Exports Markdown UI DSL documents to agent-UI formats (A2UI v1.0, json-render).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "dependencies": {
    "@mdui/core": "workspace:*",
    "@mdui/lint": "workspace:*"
  },
  "devDependencies": {
    "@json-render/core": "^0.21.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "zod": "^4.6.5"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  }
}
