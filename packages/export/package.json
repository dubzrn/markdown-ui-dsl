{
  "name": "@vrillabs/mdui-export",
  "version": "0.1.0",
  "description": "Exports Markdown UI DSL documents to agent-UI formats (A2UI v1.0, json-render).",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@vrillabs/mdui-core": "workspace:*"
  },
  "devDependencies": {
    "@json-render/core": "^0.21.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "zod": "^4.6.5"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dubzrn/markdown-ui-dsl.git",
    "directory": "packages/export"
  },
  "homepage": "https://github.com/dubzrn/markdown-ui-dsl#readme",
  "bugs": {
    "url": "https://github.com/dubzrn/markdown-ui-dsl/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19"
  }
}
